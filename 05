class Employee():
    empCount=0   #클래스변수 여기 정의
    def __init__ (self,name,salary) :
        self.name =name
        self.salary = salary
        Employee.empCount += 1   # 직원 수 계산

    def displayEmp (self):
        print("Name:",self.name, "Salary:",{self.salary})
        
    
emp1 = Employee("Kim",5000)
emp2 = Employee("Lee",6000)

emp1.displayEmp()
emp2.displayEmp()

print("총 직원 수:", Employee.empCount)   #이렇게 직원 수 계산해주는거임^^