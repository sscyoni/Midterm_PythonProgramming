class Employee():
    def __init__ (self,name,salary) :
        self.name =name
        self.salary = salary
    
    def raise_salary(self,ss) :
        print (f"{self.name}의 연봉이 {ss}으로 증가되었습니다 ")
    
    
emp1 = Employee("Kim",5000)
emp2 = Employee("Lee",6000)

print(f"{emp1.name}의 연봉은 {emp1.salary}")
print(f"{emp2.name}의 연봉은 {emp2.salary}")
emp1.raise_salary(7000)
emp2.raise_salary(8000)